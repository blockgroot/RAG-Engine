# Browser-facing API base. Same-origin `/api` is the default and the production
# setting: next.config.js rewrites `/api/:path*` to API_PROXY_TARGET so the
# session cookie is first-party (SameSite=Lax). Do not set this to the Render
# URL — vercel.app fetching onrender.com will look logged out after magic-link.
NEXT_PUBLIC_API_BASE_URL=/api
#
# Upstream FastAPI origin for the rewrite. Server-side only (not NEXT_PUBLIC).
# Local:
API_PROXY_TARGET=http://localhost:8000
# Vercel production:
# API_PROXY_TARGET=https://your-api.onrender.com
#
# Escape hatch: talk to FastAPI directly (same-site only, e.g. both localhost).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
