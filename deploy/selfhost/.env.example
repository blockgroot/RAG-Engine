# Handbook settings.
#
# ./install.sh copies this file to .env and generates the secrets at the
# bottom. Fill in everything under "Fill these in", then run ./install.sh
# again. Values go right after the "=", with no quotes or spaces around them.

# ============================================================================
# Fill these in
# ============================================================================

# --- Your Handbook ----------------------------------------------------------

# The address people open, without https://. A DNS record must point it at
# this server, and ports 80 and 443 must be open. Use localhost to try
# Handbook on this computer.
HANDBOOK_DOMAIN=

# Your company, and the work email of its first admin (you). The admin signs
# in with this address and invites everyone else; there is no public sign-up.
HANDBOOK_COMPANY=
HANDBOOK_ADMIN_EMAIL=

# --- AI model: writes the answers --------------------------------------------

# Handbook is tuned and tested with Claude. Others work, but charts and
# Agent mode need a strong model. Handbook checks the key and model when it
# starts, and names the problem if one is wrong.
#
#   Claude:   leave LLM_ADAPTER and LLM_MODEL empty (Claude Sonnet is used).
#             Key: console.anthropic.com > API keys
#   OpenAI:   LLM_ADAPTER=openai   LLM_MODEL=gpt-4.1 (or another OpenAI model)
#             Key: platform.openai.com > API keys
#   Gemini:   LLM_ADAPTER=google   LLM_MODEL=gemini-2.5-flash (or another)
#             Key: aistudio.google.com > Get API key
#   Also:     groq, mistral, deepseek, xai, together, fireworks, cerebras,
#             cohere, openrouter, nvidia, perplexity: LLM_ADAPTER=<that name>
#             and LLM_MODEL as that service names the model.
#   Any other OpenAI-compatible service (Azure OpenAI, a model on your own
#   server, ...): LLM_ADAPTER=custom, LLM_BASE_URL=<its address, usually
#   ending in /v1>, LLM_MODEL=<its model name>.
LLM_API_KEY=
LLM_ADAPTER=
LLM_MODEL=
LLM_BASE_URL=

# --- Search: turns documents into vectors -----------------------------------

# Choose before your first sync: vectors from two models cannot be mixed, so
# changing it later means syncing every document again. Handbook stores
# vectors of 1024 numbers and refuses to start with a model that does not
# fit, naming the size it got.
#
#   Jina (recommended, also ranks results): only the key.
#             Key: jina.ai > API
#   OpenAI:   EMBEDDING_BASE_URL=https://api.openai.com/v1
#             EMBEDDING_MODEL=text-embedding-3-small
#             EMBEDDING_SEND_DIMENSIONS=true
#             RETRIEVAL_RERANK_ENABLED=false   (result ranking needs Jina)
#   Another OpenAI-compatible service: its EMBEDDING_BASE_URL and
#             EMBEDDING_MODEL, plus RETRIEVAL_RERANK_ENABLED=false. If its
#             model returns another size but can shorten it on request, also
#             EMBEDDING_SEND_DIMENSIONS=true. Any other size needs the
#             database changed first ("Choosing an embedding model" in
#             docs/INSTALL.md).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_SEND_DIMENSIONS=
RETRIEVAL_RERANK_ENABLED=

# --- Email: sends sign-in links ------------------------------------------------

# Your mail server's SMTP details; your mail admin has them. For example:
#   Microsoft 365:     smtp.office365.com, your mailbox and its password
#   Google Workspace:  smtp.gmail.com, your address and an app password
#   SendGrid:          smtp.sendgrid.net, username "apikey", an API key
# EMAIL_SMTP_PORT is 587 when empty.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=

# --- Our image registry ----------------------------------------------------------

# The username and token we sent you with your license. They let this server
# download Handbook and its new versions. Leave empty only if our images are
# public to you.
REGISTRY_USERNAME=
REGISTRY_TOKEN=

# ============================================================================
# Fill in later: the tools you connect
# ============================================================================

# Only the tools you use. docs/CONNECTORS.md shows how to create each tool's
# app and where each value comes from. After adding them, run
# "docker compose up -d".

# Slack (app from apps/slack-manifest.yml)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub (App from apps/github-app.html). Private key on one line, with \n
# for each line break.
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion (the verification token arrives after you add the webhook)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# ============================================================================
# Optional
# ============================================================================

# Chat file uploads are kept in Handbook's own database (and in its backups).
# Fill these in to store them with Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Other settings you can add:
#   DATABASE_URL                     your own Postgres instead of the built-in
#                                    one (needs the vector and pg_trgm
#                                    extensions)
#   EMAIL_SENDER=sendgrid + EMAIL_SENDGRID_API_KEY   send email through
#                                    SendGrid's API instead of SMTP
#   WEB_SEARCH_ENABLED=true          answer from the web when documents don't
#                                    (sends the question to DuckDuckGo)
#   UPDATE_CHECK_ENABLED=false       stop checking for new versions (a GET of
#                                    our public release list, once in 6 hours;
#                                    nothing about you is sent)

# ============================================================================
# Set by install.sh: do not change
# ============================================================================

# The version installed; upgrade.sh and the Update button change it.
HANDBOOK_VERSION=

# Generated secrets. Without AUTH_ENCRYPTION_KEYS, saved tool sign-ins cannot
# be read back, so keep a copy of this file somewhere safe.
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
AUTH_ENCRYPTION_KEYS=
UPDATER_TOKEN=
