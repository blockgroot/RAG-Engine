# Handbook self-hosted settings. Copy to .env and fill in. Only what Handbook
# cannot know is here; everything else has a default (in the code, or in
# docker-compose.yml for the self-hosted choices).

# Version to run, and where people open Handbook (no https://; it must point
# at this server).
HANDBOOK_VERSION=1.0.0
HANDBOOK_DOMAIN=handbook.example.com

# Secrets. Generate each once and keep a copy of this file safe: without
# AUTH_ENCRYPTION_KEYS, saved connector sign-ins cannot be read back.
#   openssl rand -hex 32        -> POSTGRES_PASSWORD, AUTH_JWT_SECRET
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#                               -> AUTH_ENCRYPTION_KEYS
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
AUTH_ENCRYPTION_KEYS=

# Claude API key (checked when Handbook starts).
LLM_API_KEY=

# Search embeddings and reranking: a Jina API key.
EMBEDDING_API_KEY=

# Email for sign-in links (SMTP).
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=

# Approves new-company sign-ups.
OWNER_NOTIFICATION_EMAIL=

# Chat file uploads (Cloudinary). Leave empty to turn uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Connected tools: fill in only the ones you use. In each tool's app, enter
# https://<HANDBOOK_DOMAIN> followed by the path shown.

# Slack: sign-in /api/auth/slack/callback, events /api/slack/events,
# interactivity /api/slack/interactivity
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub App: callback and setup URL /api/auth/github/callback.
# Private key on one line, with \n for each line break.
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Google Drive: sign-in /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion: sign-in /api/auth/notion/callback, webhook /api/webhooks/notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Linear: sign-in /api/auth/linear/callback, webhook /api/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Optional overrides (add any of these to change a default):
#   DATABASE_URL                     your own Postgres (needs the vector and
#                                    pg_trgm extensions)
#   LLM_MODEL                        another Claude model
#   EMBEDDING_BASE_URL, EMBEDDING_MODEL
#                                    another OpenAI-compatible embedding
#                                    service (model must return 1024 numbers;
#                                    choose before the first sync)
#   RETRIEVAL_RERANK_ENABLED=false   turn reranking off
#   EMAIL_SENDER=sendgrid + EMAIL_SENDGRID_API_KEY
#   WEB_SEARCH_ENABLED=true          answer from the web when documents don't
#                                    (sends the question to DuckDuckGo)
