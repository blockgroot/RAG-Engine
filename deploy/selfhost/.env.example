# Handbook self-hosted settings. Copy to .env and fill in every value marked
# REQUIRED. Everything not listed here keeps Handbook's built-in default.
# Addresses (sign-in returns, webhooks) are built from HANDBOOK_DOMAIN in
# docker-compose.yml, so they are not repeated here.

# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------
# REQUIRED. The version to run; upgrading means changing this and restarting.
HANDBOOK_VERSION=1.0.0
# REQUIRED. Where people open Handbook, without https://. It must point at
# this server.
HANDBOOK_DOMAIN=handbook.example.com

# ---------------------------------------------------------------------------
# Secrets. REQUIRED. Generate each once and keep a copy of this file safe:
# without AUTH_ENCRYPTION_KEYS, saved connector sign-ins cannot be read back.
# ---------------------------------------------------------------------------
#   openssl rand -hex 32                     (POSTGRES_PASSWORD, AUTH_JWT_SECRET)
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#                                            (AUTH_ENCRYPTION_KEYS)
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
AUTH_ENCRYPTION_KEYS=

# To use your own managed Postgres instead of the bundled one (needs the
# vector and pg_trgm extensions; a direct or session-mode connection):
# DATABASE_URL=postgresql://user:password@host:5432/handbook

# ---------------------------------------------------------------------------
# AI model. REQUIRED. Handbook is built and tested on Claude.
# The key is checked when Handbook starts; a wrong one stops it with a message.
# ---------------------------------------------------------------------------
LLM_ADAPTER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
# Requests per minute Handbook may send. Interactive questions are never held
# back; background work leaves LLM_RESERVE_RPM free. Match your plan's limit.
LLM_MAX_RPM=50
LLM_RESERVE_RPM=10

# ---------------------------------------------------------------------------
# Search embeddings. REQUIRED. Any OpenAI-compatible /embeddings service whose
# model returns 1024 numbers (Jina below, or your own BGE-M3 server).
# Choose before the first sync: changing the model means re-syncing everything.
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=remote
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# Result reranking (Jina format). Uses EMBEDDING_API_KEY unless set. To turn
# it off instead: RETRIEVAL_RERANK_ENABLED=false
RERANKER_BACKEND=remote
RERANKER_BASE_URL=https://api.jina.ai/v1
RERANKER_MODEL=jina-reranker-v3
# RERANKER_API_KEY=

# ---------------------------------------------------------------------------
# Email. REQUIRED: sign-in links are sent by email.
# ---------------------------------------------------------------------------
EMAIL_SENDER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
# Or SendGrid: EMAIL_SENDER=sendgrid and EMAIL_SENDGRID_API_KEY=

# REQUIRED for now. New-company sign-ups are approved by this address.
OWNER_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# File uploads in chat. Currently stored in Cloudinary; leave empty to turn
# uploads off.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Connected tools. Fill in only the tools you use; each is off until its keys
# are set. The addresses to enter in each app are https://<HANDBOOK_DOMAIN>
# followed by the path shown.
# ---------------------------------------------------------------------------
# Slack. Sign-in /api/auth/slack/callback, events /api/slack/events,
# interactivity /api/slack/interactivity
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub App. Callback and setup URL /api/auth/github/callback
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The App's private key, on one line with \n for each line break.
GITHUB_APP_PRIVATE_KEY=

# Google Drive. Sign-in /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion. Sign-in /api/auth/notion/callback, webhook /api/webhooks/notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Linear. Sign-in /api/auth/linear/callback, webhook /api/webhooks/linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Web search sends the asker's words to DuckDuckGo when your documents do not
# answer. Off unless you turn it on.
WEB_SEARCH_ENABLED=false
