# Handbook self-hosted settings. Copy to .env and fill in. Only what Handbook
# cannot know is here; everything else has a default (in the code, or in
# docker-compose.yml for the self-hosted choices).

# Version to run, and where people open Handbook (no https://; it must point
# at this server).
HANDBOOK_VERSION=1.0.0
HANDBOOK_DOMAIN=handbook.example.com

# Secrets. Generate each once and keep a copy of this file safe: without
# AUTH_ENCRYPTION_KEYS, saved connector sign-ins cannot be read back.
#   openssl rand -hex 32        -> POSTGRES_PASSWORD, AUTH_JWT_SECRET, UPDATER_TOKEN
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#                               -> AUTH_ENCRYPTION_KEYS
POSTGRES_PASSWORD=
AUTH_JWT_SECRET=
AUTH_ENCRYPTION_KEYS=
UPDATER_TOKEN=

# The username and token we sent you for our image registry, so the Update
# button in Admin › Updates can download new versions. Leave empty if our
# images are public to you.
REGISTRY_USERNAME=
REGISTRY_TOKEN=

# Claude API key (checked when Handbook starts).
LLM_API_KEY=

# Search embeddings and reranking: a Jina API key.
EMBEDDING_API_KEY=

# Email for sign-in links (SMTP).
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=

# Your company and its first admin. install.sh creates them on first start;
# everyone else joins by the admin's invite (there is no public sign-up).
HANDBOOK_COMPANY=
HANDBOOK_ADMIN_EMAIL=

# Chat file uploads. Leave empty to keep them in Handbook's own database
# (included in backups). Fill in to store them with Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Connected tools: fill in only the ones you use. docs/CONNECTORS.md shows how
# to create each tool's app and where each value comes from.

# Slack (app from apps/slack-manifest.yml)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# GitHub (App from apps/github-app.html). Private key on one line, with \n
# for each line break.
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion (the verification token arrives after you add the webhook)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Linear
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Optional overrides (add any of these to change a default):
#   DATABASE_URL                     your own Postgres (needs the vector and
#                                    pg_trgm extensions)
#   LLM_MODEL                        another Claude model
#   EMBEDDING_BASE_URL, EMBEDDING_MODEL
#                                    any OpenAI-compatible embedding service.
#                                    See the note on embedding size below.
#   RETRIEVAL_RERANK_ENABLED=false   turn reranking off
#   EMAIL_SENDER=sendgrid + EMAIL_SENDGRID_API_KEY
#   WEB_SEARCH_ENABLED=true          answer from the web when documents don't
#                                    (sends the question to DuckDuckGo)
#   UPDATE_CHECK_ENABLED=false       stop checking for new versions (a GET of
#                                    our public release list, once in 6 hours;
#                                    nothing about you is sent)

# Note on embedding size. You can use any embedding model, but Handbook's
# database stores vectors of 1024 numbers. Handbook checks this when it
# starts and refuses to start on a mismatch, naming the size it got.
#   - A model that returns 1024 numbers (Jina v3, BGE-M3, ...) just works.
#   - A model that can shorten its vectors on request (OpenAI
#     text-embedding-3, Cohere v4, ...): also set
#     EMBEDDING_SEND_DIMENSIONS=true and it is asked for 1024.
#   - Any other size: the database's vector size must be changed first
#     ("Changing the embedding size" in the install guide).
# Choose the model before the first sync. Vectors from two models cannot be
# compared, so changing it later means re-syncing every document.
