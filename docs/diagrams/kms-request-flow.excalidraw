   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KMS: Amazon's key vault. It holds each company's master key and never lets it out. It unlocks only for our server, and\nwrites down every use.",
   "originalText": "KMS: Amazon's key vault. It holds each company's master key and never lets it out. It unlocks only for our server, and\nwrites down every use.",
