# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# --- LLM: FreeLLMAPI (OpenAI-compatible) ---
# When running the FreeLLMAPI docker container locally, base URL is the /v1 path.
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=your-freellmapi-key-here
LLM_MODEL=auto

# --- Embeddings: DeepInfra serving BGE-M3 (OpenAI-compatible) ---
EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDING_API_KEY=your-deepinfra-key-here
EMBEDDING_MODEL=BAAI/bge-m3
