# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# --- LLM: FreeLLMAPI (OpenAI-compatible) ---
# When running the FreeLLMAPI docker container locally, base URL is the /v1 path.
LLM_BASE_URL=http://localhost:3001/v1
LLM_API_KEY=your-freellmapi-key-here
LLM_MODEL=auto

# --- Embeddings: local, in-process via sentence-transformers ---
# Runs on your machine ($0, no API key, data stays local). Downloads the model
# once on first use. Optional EMBEDDING_DEVICE: cpu | cuda | mps (auto if unset).
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu
