# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# =========================================================================
# LLM  (provider-agnostic via the OpenAI client + base_url swap)
# =========================================================================
# Switch providers/models by changing these three vars only — no code changes.
#
# Pick ONE configuration:
#
# 1) FreeLLMAPI or any OpenAI-compatible / self-hosted endpoint (current setup)
LLM_MODEL=auto
LLM_API_KEY=your-freellmapi-key-here
LLM_BASE_URL=http://localhost:3001/v1
#
# 2) Native OpenAI  (leave LLM_BASE_URL empty to use the default endpoint)
# LLM_MODEL=gpt-5
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
#
# 3) Google Gemini  (OpenAI-compatible endpoint)
# LLM_MODEL=gemini-3.5-flash
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# 4) Anthropic / Claude  (OpenAI-compatible endpoint)
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1/
#
# Note: the Gemini and Anthropic OpenAI-compatible endpoints are vendor-labelled
# beta/testing (no prompt caching, some params dropped). Fine for basic chat.

# =========================================================================
# Embeddings
# =========================================================================
# EMBEDDING_BACKEND: "local" (in-process, default) or "remote" (HTTP endpoint).

# --- local: in-process via sentence-transformers ($0, no key, data stays local)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu        # optional: cpu | cuda | mps (auto if unset)

# --- remote alternative: OpenAI-compatible embeddings endpoint (e.g. DeepInfra)
# EMBEDDING_BACKEND=remote
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=your-deepinfra-key
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai

# =========================================================================
# Database  (Postgres + pgvector)  — Phase 2
# =========================================================================
# libpq connection string. Required for the vector store and the tests.
# Matches the bundled docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
# Vector dimension of the chunks.embedding column. MUST match the embedding
# model output (BGE-M3 = 1024) and the value in app/db/schema.sql.
EMBEDDING_DIM=1024
# Connection-pool sizing (optional).
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# =========================================================================
# Chunking  (characters)  — Phase 2
# =========================================================================
# Deliberate defaults; reasoning in app/ingestion/chunking.py.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# =========================================================================
# Vector store  — Phase 2
# =========================================================================
VECTOR_STORE_BACKEND=pgvector

# =========================================================================
# RAG query path  — Phase 3
# =========================================================================
# How many chunks to retrieve per question.
RAG_TOP_K=5
# Minimum cosine similarity (0..1) the best chunk must clear before the LLM is
# called; below it we return the fallback without a model call. Default 0.35 sits
# just above noise (~0.30) and below any genuinely relevant chunk (>=~0.46).
# Reasoning: app/rag/pipeline.py.
RAG_SIMILARITY_THRESHOLD=0.35
# The single fixed "I don't know" response (used by the gate, the prompt, and
# refusal detection). Override only if you want different user-facing wording.
# RAG_FALLBACK_RESPONSE=I don't have information on that in the available policy documents.

# =========================================================================
# Notion source  — Phase 4, per-organization credentials since Phase 9
# =========================================================================
# Auth is a Notion INTERNAL integration secret (a static token). Create one at
# https://www.notion.so/my-integrations, copy its "Internal Integration Secret",
# and share the page(s) you want ingested with that integration.
#
# Default token — used when an ingestion run names no specific org token (e.g. the
# single Phase 4 test org):
NOTION_TOKEN=your-notion-internal-integration-secret
#
# Per-organization tokens (Phase 9): give EACH real organization its own Notion
# integration + secret, one env var per org named NOTION_TOKEN_<NAME>. Because an
# integration only sees pages explicitly shared with it, each org's token is a real
# access boundary enforced by Notion — not just isolation our code keeps straight.
# Orgs are pure config: adding one later is a new line here + one ingestion run,
# never a code change. Point a run at one by its <name> (case-insensitive):
#     python scripts/ingest_notion.py --org "Acme Corp"   --token acme
#     python scripts/ingest_notion.py --org "Globex Inc"  --token globex
# NOTE: real multi-org data entry + ingestion happens in the NEXT step, not now.
# NOTION_TOKEN_ACME=ntn_your-acme-integration-secret
# NOTION_TOKEN_GLOBEX=ntn_your-globex-integration-secret
#
# OAuth app credentials — read but NOT used yet; reserved for the later
# multi-tenant OAuth phase (kept here so they aren't hardcoded).
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=

# =========================================================================
# Conversation memory  — Phase 5, incremental summarization since Phase 8
# =========================================================================
# The most recent MEMORY_RECENT_TURNS turns are kept verbatim; every turn that
# falls out of that window is folded into a running summary INCREMENTALLY (one
# turn per update, no bulk threshold). Reasoning: app/rag/pipeline.py.
# MEMORY_RECENT_TURNS=3

# =========================================================================
# Web-search fallback  — Phase 5
# =========================================================================
# Used only when internal retrieval fails the gate AND the model judges the
# question to be about a real external named entity. Default is keyless
# DuckDuckGo. Set provider=tavily + a key for production-grade quality.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT=8
# WEB_SEARCH_API_KEY=            # required only for tavily/brave

# =========================================================================
# Retrieval: contextual retrieval + hybrid search + reranking — Phase 6
# =========================================================================
# Contextual retrieval (ingest-time): prepend an LLM-generated context to each
# chunk before embedding/storing. One LLM call per chunk at ingest, no query cost.
# INGEST_CONTEXTUAL_ENABLED=true
#
# Hybrid search + cross-encoder reranking (query-time), under the unchanged gate.
# RETRIEVAL_HYBRID_ENABLED=true      # fuse vector + keyword (RRF)
# RETRIEVAL_RERANK_ENABLED=true      # cross-encoder rerank the candidate pool
# RETRIEVAL_CANDIDATE_POOL=30        # candidates fetched/reranked before top_k
# RETRIEVAL_RRF_K=60                 # Reciprocal Rank Fusion constant
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # or bge-reranker-base / ms-marco-MiniLM (faster)
# RERANKER_DEVICE=                   # cpu | cuda | mps (auto if unset)

# =========================================================================
# Retrieval reuse across conversation turns  — Phase 8
# =========================================================================
# Before retrieval on a follow-up, a cheap NON-LLM cosine check compares the
# rewritten question to the previous turn's chunks; if close enough they're reused
# and retrieval is skipped (the reused chunks still pass the unchanged gate). The
# threshold is deliberately high (a wrong reuse gives a wrong "I don't know"; a
# missed reuse only costs one retrieval) — a starting point, see CLAUDE.md §4.
# RETRIEVAL_REUSE_ENABLED=true
# RETRIEVAL_REUSE_THRESHOLD=0.72

# =========================================================================
# Bounded retrieval recovery (Retrieval Discovery Gap)
# =========================================================================
# First retrieve is unchanged. Only when evidence looks insufficient (gate miss
# or generation finds context insufficient) do we run at most ONE recovery:
# LLM produces alternate retrieval expressions → re-retrieve + RRF-merge →
# same gate + grounded prompt. Never replaces user intent; never weakens
# grounding. On expander failure the existing path continues.
# RECOVERY_ENABLED=true
# RECOVERY_MAX_QUERIES=2
