# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# =========================================================================
# LLM  (provider-agnostic via the OpenAI client + base_url swap)
# =========================================================================
# Switch providers/models by changing these three vars only — no code changes.
#
# Pick ONE configuration:
#
# 1) FreeLLMAPI or any OpenAI-compatible / self-hosted endpoint (current setup)
LLM_MODEL=auto
# Prefer a *named* fast model over `auto` when the endpoint queues slowly —
# `auto` is often the main cause of 30–90s+ chat waits on FreeLLMAPI.
# Optional cheaper/faster model for rewrite / decompose / recovery / summary / ingest context (Phase 19).
# LLM_AUX_MODEL=auto
# LLM_TIMEOUT=45
LLM_API_KEY=your-freellmapi-key-here
LLM_BASE_URL=http://localhost:3001/v1
#
# 2) Native OpenAI  (leave LLM_BASE_URL empty to use the default endpoint)
# LLM_MODEL=gpt-5
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
#
# 3) Google Gemini  (OpenAI-compatible endpoint)
# LLM_MODEL=gemini-3.5-flash
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# 4) Anthropic / Claude  (OpenAI-compatible endpoint)
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1/
#
# Note: the Gemini and Anthropic OpenAI-compatible endpoints are vendor-labelled
# beta/testing (no prompt caching, some params dropped). Fine for basic chat.

# =========================================================================
# Embeddings
# =========================================================================
# EMBEDDING_BACKEND: "local" (in-process, default) or "remote" (HTTP endpoint).

# --- local: in-process via sentence-transformers ($0, no key, data stays local)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu        # optional: cpu | cuda | mps (auto if unset)

# --- remote alternative: OpenAI-compatible embeddings endpoint (e.g. DeepInfra)
# EMBEDDING_BACKEND=remote
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=your-deepinfra-key
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai

# =========================================================================
# Database  (Postgres + pgvector)  — Phase 2
# =========================================================================
# libpq connection string. Required for the vector store and the tests.
# Matches the bundled docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
# Vector dimension of the chunks.embedding column. MUST match the embedding
# model output (BGE-M3 = 1024) and the value in app/db/schema.sql.
EMBEDDING_DIM=1024
# Connection-pool sizing (optional).
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# =========================================================================
# Chunking  (characters)  — Phase 2
# =========================================================================
# Deliberate defaults; reasoning in app/ingestion/chunking.py.
CHUNK_SIZE=256
CHUNK_OVERLAP=40

# =========================================================================
# Vector store  — Phase 2
# =========================================================================
VECTOR_STORE_BACKEND=pgvector

# =========================================================================
# RAG query path  — Phase 3
# =========================================================================
# How many chunks to retrieve per question.
RAG_TOP_K=5
# Minimum cosine similarity (0..1) the best chunk must clear before the LLM is
# called; below it we return the fallback without a model call. Default 0.35 sits
# just above noise (~0.30) and below any genuinely relevant chunk (>=~0.46).
# Reasoning: app/rag/pipeline.py.
RAG_SIMILARITY_THRESHOLD=0.35
# Cap retrieved context chars in the grounded prompt (latency — shorter prompts).
# RAG_MAX_CONTEXT_CHARS=6000
# Cap answer completion tokens (latency on slow free endpoints). Set 0 to disable.
# RAG_MAX_ANSWER_TOKENS=700
# Max seconds a follow-up waits for the previous turn's background summary fold.
# MEMORY_FOLD_WAIT_SECONDS=2
# The single fixed "I don't know" response (used by the gate, the prompt, and
# refusal detection). Override only if you want different user-facing wording.
# RAG_FALLBACK_RESPONSE=I don't have information on that in the available policy documents.

# =========================================================================
# Notion source  — Phase 4, per-organization credentials since Phase 9
# =========================================================================
# Auth is a Notion INTERNAL integration secret (a static token). Create one at
# https://www.notion.so/my-integrations, copy its "Internal Integration Secret",
# and share the page(s) you want ingested with that integration.
#
# Default token — used when an ingestion run names no specific org token (e.g. the
# single Phase 4 test org):
NOTION_TOKEN=your-notion-internal-integration-secret
#
# Per-organization tokens (Phase 9): give EACH real organization its own Notion
# integration + secret, one env var per org named NOTION_TOKEN_<NAME>. Because an
# integration only sees pages explicitly shared with it, each org's token is a real
# access boundary enforced by Notion — not just isolation our code keeps straight.
# Orgs are pure config: adding one later is a new line here + one ingestion run,
# never a code change. Point a run at one by its <name> (case-insensitive):
#     python scripts/ingest_notion.py --org "Acme Corp"   --token acme
#     python scripts/ingest_notion.py --org "Globex Inc"  --token globex
# NOTE: real multi-org data entry + ingestion happens in the NEXT step, not now.
# NOTION_TOKEN_ACME=ntn_your-acme-integration-secret
# NOTION_TOKEN_GLOBEX=ntn_your-globex-integration-secret
#
# OAuth app credentials — used by NotionOAuthProvider (admin "Connect Notion").
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:8000/auth/notion/callback

# =========================================================================
# Google Drive / Docs source  — Google Integration
# =========================================================================
# Internal-use OAuth client preferred (Workspace): exempt from Google's
# verification / CASA / 7-day testing-mode refresh expiry. Testing-mode
# clients expire refresh tokens after 7 days — ingestion will then fail with
# a reconnect error until the admin re-consents.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional override (space-delimited). Defaults to drive.readonly + documents.readonly.
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/documents.readonly

# =========================================================================
# Conversation memory  — Phase 5, incremental summarization since Phase 8
# =========================================================================
# The most recent MEMORY_RECENT_TURNS turns are kept verbatim; every turn that
# falls out of that window is folded into a running summary INCREMENTALLY (one
# turn per update, no bulk threshold). Reasoning: app/rag/pipeline.py.
# MEMORY_RECENT_TURNS=3

# =========================================================================
# Web-search fallback  — Phase 5
# =========================================================================
# Used only when internal retrieval fails the gate AND the model judges the
# question to be about a real external named entity. Default is keyless
# DuckDuckGo. Set provider=tavily + a key for production-grade quality.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT=8
# WEB_SEARCH_API_KEY=            # required only for tavily/brave

# =========================================================================
# Retrieval: contextual retrieval + hybrid search + reranking — Phase 6
# =========================================================================
# Contextual retrieval (ingest-time): prepend an LLM-generated context to each
# chunk before embedding/storing. One LLM call per chunk at ingest, no query cost.
# INGEST_CONTEXTUAL_ENABLED=true
#
# Hybrid search + cross-encoder reranking (query-time), under the unchanged gate.
# RETRIEVAL_HYBRID_ENABLED=true      # fuse vector + keyword (RRF)
# RETRIEVAL_RERANK_ENABLED=true      # cross-encoder rerank the candidate pool
# RETRIEVAL_CANDIDATE_POOL=16        # candidates fetched/reranked before top_k
# RETRIEVAL_RRF_K=60                 # Reciprocal Rank Fusion constant
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # or bge-reranker-base / ms-marco-MiniLM (faster)
# RERANKER_DEVICE=                   # cpu | cuda | mps (auto if unset)

# =========================================================================
# Retrieval reuse across conversation turns  — Phase 8
# =========================================================================
# Before retrieval on a follow-up, a cheap NON-LLM cosine check compares the
# rewritten question to the previous turn's chunks; if close enough they're reused
# and retrieval is skipped (the reused chunks still pass the unchanged gate). The
# threshold is deliberately high (a wrong reuse gives a wrong "I don't know"; a
# missed reuse only costs one retrieval) — a starting point, see CLAUDE.md §4.
# RETRIEVAL_REUSE_ENABLED=true
# RETRIEVAL_REUSE_THRESHOLD=0.72

# =========================================================================
# Bounded retrieval recovery (Retrieval Discovery Gap)
# =========================================================================
# First retrieve is unchanged. Only when evidence looks insufficient (gate miss
# or generation finds context insufficient) do we run at most ONE recovery:
# LLM produces alternate retrieval expressions → re-retrieve + RRF-merge →
# same gate + grounded prompt. Never replaces user intent; never weakens
# grounding. On expander failure the existing path continues.
# RECOVERY_ENABLED=true
# RECOVERY_MAX_QUERIES=2

# Compound-question decomposition (Phase 18). Heuristic gate; LLM only when likely multi-ask.
# DECOMPOSE_ENABLED=true

# Request deadline (seconds) and minimum reserve per optional LLM stage (Phase 19).
# REQUEST_DEADLINE_SECONDS=45
# REQUEST_BUDGET_MIN_STAGE_SECONDS=3

# Standalone question answer cache (Postgres, short TTL).
# QUERY_CACHE_ENABLED=true
# QUERY_CACHE_TTL_SECONDS=300

# Rate limiting on POST /chat/stream (Postgres counters).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHAT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# Ingestion sanitization (max document size + malformed/binary guard).
# INGEST_MAX_DOCUMENT_CHARS=2000000
# INGEST_MAX_CONTROL_CHAR_RATIO=0.05

# =========================================================================
# Query spelling normalization (Phase 17)
# =========================================================================
# Cheap SymSpell against this org's chunk vocabulary (+ common query English
# seeds) before embed/retrieve. Generation still uses the unresolved question.
# Kill-switch / tune:
# QUERY_NORM_ENABLED=true
# QUERY_NORM_MAX_EDIT_DISTANCE=1
# QUERY_NORM_MIN_WORD_LENGTH=4

# =========================================================================
# Auth / sessions / credential encryption  — Phase 10-13
# =========================================================================
# Fernet key(s) that encrypt OAuth tokens at rest (oauth_connections table).
# Comma-separated for rotation: the FIRST key encrypts new values, ALL keys
# are tried on decrypt. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEYS=generate-a-real-fernet-key-see-comment-above
#
# Signs session JWTs. Use a long random string in any real deployment — never
# a well-known default.
AUTH_JWT_SECRET=change-me-to-a-long-random-string
#
# Session cookie lifetime in minutes. Defaults to 30 days (43200) — long-lived
# on purpose: this is a low-risk internal tool, the cookie is already
# httpOnly+Secure+SameSite=Lax, and there's no refresh-token flow, so the TTL
# itself is what keeps a user logged in day-to-day instead of hourly re-auth.
# AUTH_SESSION_TTL_MINUTES=43200
# AUTH_MAGIC_LINK_TTL_MINUTES=10
#
# How long a one-click signup-approval email link (approve/reject) stays
# valid/single-use. Default 72 hours.
# AUTH_SIGNUP_ACTION_TTL_HOURS=72
#
# POST /auth/signup (create a brand-new org + become its admin) no longer
# creates anything synchronously or checks a whitelist — it queues a pending
# row in org_signup_requests for human review. Review it with:
#   python scripts/review_signup_requests.py list
#   python scripts/review_signup_requests.py approve <request_id>
#   python scripts/review_signup_requests.py reject <request_id> --reason "..."
# Or set OWNER_NOTIFICATION_EMAIL below to get an email per request with
# one-click approve/reject confirmation links. Everyone else joins an
# EXISTING org via an admin invite (POST /admin/members) instead.

# =========================================================================
# HTTP API (app/api/) + frontend  — Phase 13/14
# =========================================================================
# Exact frontend origin(s) allowed to call the API with credentials (the
# session cookie). No wildcard default — required for the portal to work.
API_CORS_ORIGINS=http://localhost:3000
# API_HOST=0.0.0.0
# API_PORT=8000
#
# Base URL of the deployed frontend — used to build the magic-link login URL
# and the post-OAuth-connect redirect destination.
FRONTEND_URL=http://localhost:3000

# =========================================================================
# Outbound email for magic links  — Phase 13
# =========================================================================
# "console" (default): prints the sign-in link instead of sending it — no
# external dependency, works out of the box for local/self-hosted dev.
EMAIL_SENDER=console
# Set to "smtp" for real delivery:
# EMAIL_SENDER=smtp
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_FROM=noreply@example.com
#
# Set this to get a notification email (with one-click approve/reject links)
# every time someone submits POST /auth/signup. Leave unset to rely solely on
# `python scripts/review_signup_requests.py list`.
# OWNER_NOTIFICATION_EMAIL=owner@yourcompany.com
#
# Reminder: the Notion OAuth app credentials for the admin "Connect Notion"
# flow are the NOTION_CLIENT_ID / NOTION_CLIENT_SECRET / NOTION_REDIRECT_URI
# vars already defined above in the Notion source section — they are consumed
# by NotionOAuthProvider. Google Drive uses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI (GoogleOAuthProvider).
