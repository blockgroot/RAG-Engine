# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# =========================================================================
# LLM  (provider-agnostic via the OpenAI client + base_url swap)
# =========================================================================
# Switch providers/models by changing these three vars only — no code changes.
#
# Pick ONE configuration:
#
# 1) FreeLLMAPI or any OpenAI-compatible / self-hosted endpoint (current setup)
LLM_MODEL=auto
# Prefer a *named* fast model over `auto` when the endpoint queues slowly —
# `auto` is often the main cause of 30–90s+ chat waits on FreeLLMAPI.
# Optional cheaper/faster model for rewrite / decompose / recovery / summary / ingest context (Phase 19).
# LLM_AUX_MODEL=auto
# LLM_TIMEOUT=45
LLM_API_KEY=your-freellmapi-key-here
LLM_BASE_URL=http://localhost:3001/v1
#
# 2) Native OpenAI  (leave LLM_BASE_URL empty to use the default endpoint)
# LLM_MODEL=gpt-5
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
#
# 3) Google Gemini  (OpenAI-compatible endpoint)
# LLM_MODEL=gemini-3.5-flash
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# 4) Anthropic / Claude  (OpenAI-compatible endpoint)
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1/
#
# Note: the Gemini and Anthropic OpenAI-compatible endpoints are vendor-labelled
# beta/testing (no prompt caching, some params dropped). Fine for basic chat.

# =========================================================================
# Embeddings
# =========================================================================
# EMBEDDING_BACKEND: "local" (in-process, default) or "remote" (HTTP endpoint).

# --- local: in-process via sentence-transformers ($0, no key, data stays local)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu        # optional: cpu | cuda | mps (auto if unset)
#
# RAM note (16GB laptops): local BGE-M3 (~2–4GB RSS) + bge-reranker-v2-m3
# (~1–2GB) can thrash the machine into swap, especially with uvicorn --reload
# (parent+child) or Cursor open. Models are process-wide singletons now; still:
# prefer `uvicorn ...` WITHOUT --reload for chat demos, use the Code/GitHub
# tab when you only need repos (no embedder load), or set RETRIEVAL_RERANK_ENABLED=false
# / a lighter RERANKER_MODEL if policy chat is too heavy.

# --- remote alternative: OpenAI-compatible embeddings endpoint
# Preferred for cloud deploys (no multi-GB local BGE-M3). Jina v3 is 1024-d
# like BGE-M3 so EMBEDDING_DIM stays 1024 — still RE-INGEST after switching
# models (same width ≠ same vectors). One Jina key covers embed + rerank.
# Get a key: https://jina.ai/?sui=apikey
# EMBEDDING_BACKEND=remote
# EMBEDDING_MODEL=jina-embeddings-v3
# EMBEDDING_API_KEY=jina_...
# EMBEDDING_BASE_URL=https://api.jina.ai/v1
#
# Other OpenAI-compatible hosts (DeepInfra BGE-M3, etc.) also work:
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=your-deepinfra-key
# EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai

# =========================================================================
# Database  (Postgres + pgvector)  — Phase 2
# =========================================================================
# libpq connection string. Required for the vector store and the tests.
# Matches the bundled docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag
# Vector dimension of the chunks.embedding column. MUST match the embedding
# model output (BGE-M3 = 1024) and the value in app/db/schema.sql.
EMBEDDING_DIM=1024
# Connection-pool sizing (optional).
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# =========================================================================
# Chunking  (characters)  — Phase 2
# =========================================================================
# Deliberate defaults; reasoning in app/ingestion/chunking.py.
CHUNK_SIZE=256
CHUNK_OVERLAP=40

# =========================================================================
# Vector store  — Phase 2
# =========================================================================
VECTOR_STORE_BACKEND=pgvector

# =========================================================================
# RAG query path  — Phase 3
# =========================================================================
# How many chunks to retrieve per question.
RAG_TOP_K=5
# Minimum cosine similarity (0..1) the best chunk must clear before the LLM is
# called; below it we return the fallback without a model call. Default 0.35 sits
# just above noise (~0.30) and below any genuinely relevant chunk (>=~0.46).
# Reasoning: app/rag/pipeline.py.
RAG_SIMILARITY_THRESHOLD=0.35
# Cap retrieved context chars in the grounded prompt (latency — shorter prompts).
# RAG_MAX_CONTEXT_CHARS=6000
# Cap answer completion tokens (latency on slow free endpoints). Set 0 to disable.
# RAG_MAX_ANSWER_TOKENS=700
# Max seconds a follow-up waits for the previous turn's background summary fold.
# MEMORY_FOLD_WAIT_SECONDS=2
# The single fixed "I don't know" response (used by the gate, the prompt, and
# refusal detection). Override only if you want different user-facing wording.
# RAG_FALLBACK_RESPONSE=I don't have information on that in the available policy documents.

# =========================================================================
# Notion source  — Phase 4, per-organization credentials since Phase 9
# =========================================================================
# Auth is a Notion INTERNAL integration secret (a static token). Create one at
# https://www.notion.so/my-integrations, copy its "Internal Integration Secret",
# and share the page(s) you want ingested with that integration.
#
# Default token — used when an ingestion run names no specific org token (e.g. the
# single Phase 4 test org):
NOTION_TOKEN=your-notion-internal-integration-secret
#
# Per-organization tokens (Phase 9): give EACH real organization its own Notion
# integration + secret, one env var per org named NOTION_TOKEN_<NAME>. Because an
# integration only sees pages explicitly shared with it, each org's token is a real
# access boundary enforced by Notion — not just isolation our code keeps straight.
# Orgs are pure config: adding one later is a new line here + one ingestion run,
# never a code change. Point a run at one by its <name> (case-insensitive):
#     python scripts/ingest_notion.py --org "Acme Corp"   --token acme
#     python scripts/ingest_notion.py --org "Globex Inc"  --token globex
# NOTE: real multi-org data entry + ingestion happens in the NEXT step, not now.
# NOTION_TOKEN_ACME=ntn_your-acme-integration-secret
# NOTION_TOKEN_GLOBEX=ntn_your-globex-integration-secret
#
# OAuth app credentials — used by NotionOAuthProvider (admin "Connect Notion").
# Redirect URIs must be the origin the BROWSER hits, because the session cookie
# is first-party on the frontend. With the Next.js `/api` rewrite that is the
# frontend origin; do not register the Render host or OAuth callbacks arrive
# without the session cookie.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

# =========================================================================
# Google Drive / Docs source  — Google Integration
# =========================================================================
# Internal-use OAuth client preferred (Workspace): exempt from Google's
# verification / CASA / 7-day testing-mode refresh expiry. Testing-mode
# clients expire refresh tokens after 7 days — ingestion will then fail with
# a reconnect error until the admin re-consents.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional override (space-delimited). Defaults to drive.readonly + documents.readonly.
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/documents.readonly

# =========================================================================
# GitHub App source  — GitHub Integration (embed nothing; live tool-calls)
# =========================================================================
# Unlike Notion/Google there is NO GITHUB_REDIRECT_URI env var. The callback
# URL is registered on the GitHub App itself (not passed in the token
# exchange). Create an App at https://github.com/settings/apps/new with:
#
#   Homepage URL:                 http://localhost:3000
#   Callback URL:                 http://localhost:3000/api/auth/github/callback
#   Setup URL (optional):         http://localhost:3000/api/auth/github/callback
#   ✔ Request user authorization (OAuth) during installation  ← required
#   Repository permissions:
#     Contents: Read-only   (README + commits)
#     Metadata: Read-only   (always required)
#   Where can this GitHub App be installed?  Any account  (or "Only this
#   account" if you're only testing against yourself)
#
# After create: copy the App slug (from the URL …/apps/<slug>), Client ID,
# generate a Client secret, and generate a private key (.pem). Paste the PEM
# either as a real multi-line block OR as a single line with literal \n.
#
# GITHUB_APP_SLUG=your-app-slug
# GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxx
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
#
# Optional live-read bounds (defaults are fine for local testing):
# GITHUB_LIVE_ENABLED=true
# GITHUB_LIVE_TIMEOUT=10.0
# GITHUB_README_MAX_BYTES=40000
# GITHUB_PATCH_MAX_BYTES=4000
# GITHUB_MAX_FILES_PER_COMMIT=25
# GITHUB_MAX_COMMITS=20

# =========================================================================
# Conversation memory  — Phase 5, incremental summarization since Phase 8
# =========================================================================
# The most recent MEMORY_RECENT_TURNS turns are kept verbatim; every turn that
# falls out of that window is folded into a running summary INCREMENTALLY (one
# turn per update, no bulk threshold). Reasoning: app/rag/pipeline.py.
# MEMORY_RECENT_TURNS=3

# =========================================================================
# Web-search fallback  — Phase 5
# =========================================================================
# Used only when internal retrieval fails the gate AND the model judges the
# question to be about a real external named entity. Default is keyless
# DuckDuckGo. Set provider=tavily + a key for production-grade quality.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT=8
# WEB_SEARCH_API_KEY=            # required only for tavily/brave

# =========================================================================
# Retrieval: contextual retrieval + hybrid search + reranking — Phase 6
# =========================================================================
# Contextual retrieval (ingest-time): prepend an LLM-generated context to each
# chunk before embedding/storing. Improves retrieval; one LLM call per chunk.
#
# DEFAULT: enabled + DEFERRED. Sync embeds raw chunks and marks the job
# succeeded immediately (onboarding unlocks); the worker then contextualizes
# + re-embeds in the background. Same quality intent, no "0 of N" stall.
# INGEST_CONTEXTUAL_ENABLED=true
# INGEST_CONTEXTUAL_DEFER=true
# Set DEFER=false for the old blocking inline path (slower sync UX).
# Keep concurrency low on free tiers (1–2). Higher bursts 429.
# INGEST_CONTEXTUAL_CONCURRENCY=2
#
# A document that chunks into more than this many pieces skips contextual
# enrichment entirely (keeps its plain, already-embedded chunks) instead of
# issuing one uncapped call per chunk — protects against a pathologically
# large single document tying up the worker indefinitely.
# INGEST_CONTEXTUAL_MAX_CHUNKS=200
#
# Embedder batch size — a document with an unusually large number of chunks
# used to encode/send them all in one shot: on the local backend that failed
# with "Failed to encode N text(s)" on low-RAM machines; on the REMOTE backend
# it sent one unbounded HTTP request/response, which OOM-crashed a
# memory-constrained deploy (Render free, 512MB) before EMBED_BATCH_SIZE was
# wired into the remote provider too. Applies to both backends now.
# EMBED_BATCH_SIZE=16
#
# Hybrid search + cross-encoder reranking (query-time), under the unchanged gate.
# RETRIEVAL_HYBRID_ENABLED=true      # fuse vector + keyword (RRF)
# RETRIEVAL_RERANK_ENABLED=true      # cross-encoder / remote; set false to skip
# RETRIEVAL_CANDIDATE_POOL=16        # candidates fetched/reranked before top_k
# RETRIEVAL_RRF_K=60                 # Reciprocal Rank Fusion constant
#
# Reranker backend: local (default, loads CrossEncoder weights) or remote
# (Jina-compatible POST /v1/rerank — no local GPU/RAM). Remote reuses
# EMBEDDING_API_KEY / EMBEDDING_BASE_URL unless RERANKER_* overrides them.
# RERANKER_BACKEND=local
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # or bge-reranker-base / ms-marco-MiniLM
# RERANKER_DEVICE=                   # cpu | cuda | mps (auto if unset)
# RERANKER_BACKEND=remote
# RERANKER_MODEL=jina-reranker-v3
# RERANKER_API_KEY=                  # optional; falls back to EMBEDDING_API_KEY
# RERANKER_BASE_URL=https://api.jina.ai/v1
# RERANKER_TIMEOUT=30
#
# Ceiling on rows the keyword (BM25) search pulls back for ONE query. Previously
# unbounded: a common term matched every such chunk and each one cost a cosine
# computation plus its full text over the wire, to keep top_k of them (measured:
# 160 rows fetched to return 30 on a 400-chunk corpus, and that ratio grows with
# the corpus). Postgres now keeps the best rows by ts_rank. Past this limit BM25
# ranks that subset rather than every match — the default is high enough to be a
# no-op at realistic sizes.
# KEYWORD_CANDIDATE_LIMIT=2000
#
# Load the embedder/reranker at API startup instead of inside the first
# question's request. Set false on a low-RAM machine, or when running the API
# only for GitHub chat (which needs neither model).
# MODEL_WARMUP_ON_STARTUP=true

# =========================================================================
# Retrieval reuse across conversation turns  — Phase 8
# =========================================================================
# Before retrieval on a follow-up, a cheap NON-LLM cosine check compares the
# rewritten question to the previous turn's chunks; if close enough they're reused
# and retrieval is skipped (the reused chunks still pass the unchanged gate). The
# threshold is deliberately high (a wrong reuse gives a wrong "I don't know"; a
# missed reuse only costs one retrieval) — a starting point, see CLAUDE.md §4.
# RETRIEVAL_REUSE_ENABLED=true
# RETRIEVAL_REUSE_THRESHOLD=0.72

# =========================================================================
# Bounded retrieval recovery (Retrieval Discovery Gap)
# =========================================================================
# First retrieve is unchanged. Only when evidence looks insufficient (gate miss
# or generation finds context insufficient) do we run at most ONE recovery:
# LLM produces alternate retrieval expressions → re-retrieve + RRF-merge →
# same gate + grounded prompt. Never replaces user intent; never weakens
# grounding. On expander failure the existing path continues.
# RECOVERY_ENABLED=true

# Semantic question-tone classify (aux LLM): FACTUAL vs SUPPORTIVE so
# empathy is only forced when the user is personally struggling — not
# merely because the topic is mental health / counselling.
# TONE_CLASSIFY_ENABLED=true
# RECOVERY_MAX_QUERIES=2

# Compound-question decomposition (Phase 18). Heuristic gate; LLM only when likely multi-ask.
# DECOMPOSE_ENABLED=true

# Request deadline (seconds) and minimum reserve per optional LLM stage (Phase 19).
# REQUEST_DEADLINE_SECONDS=45
# REQUEST_BUDGET_MIN_STAGE_SECONDS=3

# Standalone question answer cache (Postgres, short TTL).
# QUERY_CACHE_ENABLED=true
# QUERY_CACHE_TTL_SECONDS=300

# Rate limiting on POST /chat/stream (Postgres counters).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHAT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# Ingestion sanitization (max document size + malformed/binary guard).
# Also bounds the Notion adapter's block-tree fetch itself (app/sources/notion.py):
# a page with deep/wide nesting stops rendering (truncation marker appended)
# once this many characters is reached, rather than building an unbounded
# string in memory before this check ever runs post-fetch.
# INGEST_MAX_DOCUMENT_CHARS=2000000
# INGEST_MAX_CONTROL_CHAR_RATIO=0.05
#
# Ingestion worker memory admission gate: before claiming a new job, skip
# claiming (leave it queued for the next tick) if the worker's own current
# RSS is already at/above this ceiling. Defense-in-depth alongside the
# per-input bounds above -- catches memory pressure from any cause, not just
# known unbounded inputs. Default leaves ~112MB headroom under Render free's
# hard 512MB limit; raise it on a bigger instance, or disable if you'd rather
# rely purely on the per-input bounds.
# INGEST_MEMORY_GUARD_ENABLED=true
# INGEST_MAX_RSS_MB=400

# =========================================================================
# Query spelling normalization (Phase 17)
# =========================================================================
# Cheap SymSpell against this org's chunk vocabulary (+ common query English
# seeds) before embed/retrieve. Generation still uses the unresolved question.
# Kill-switch / tune:
# QUERY_NORM_ENABLED=true
# QUERY_NORM_MAX_EDIT_DISTANCE=1
# QUERY_NORM_MIN_WORD_LENGTH=4
# Max orgs' SymSpell dictionaries kept in memory (LRU) -- was unbounded and
# never evicted, a slow-leak risk once more than a handful of orgs are active.
# QUERY_NORM_CACHE_MAX_ORGS=50

# =========================================================================
# Auth / sessions / credential encryption  — Phase 10-13
# =========================================================================
# Fernet key(s) that encrypt OAuth tokens at rest (oauth_connections table).
# Comma-separated for rotation: the FIRST key encrypts new values, ALL keys
# are tried on decrypt. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEYS=generate-a-real-fernet-key-see-comment-above
#
# Signs session JWTs. Use a long random string in any real deployment — never
# a well-known default.
AUTH_JWT_SECRET=change-me-to-a-long-random-string
#
# Session cookie lifetime in minutes. Defaults to 30 days (43200) — long-lived
# on purpose: this is a low-risk internal tool, the cookie is already
# httpOnly+Secure+SameSite=Lax, and there's no refresh-token flow, so the TTL
# itself is what keeps a user logged in day-to-day instead of hourly re-auth.
# AUTH_SESSION_TTL_MINUTES=43200
# AUTH_MAGIC_LINK_TTL_MINUTES=10
#
# How long a one-click signup-approval email link (approve/reject) stays
# valid/single-use. Default 72 hours.
# AUTH_SIGNUP_ACTION_TTL_HOURS=72
#
# POST /auth/signup (create a brand-new org + become its admin) no longer
# creates anything synchronously or checks a whitelist — it queues a pending
# row in org_signup_requests. Set OWNER_NOTIFICATION_EMAIL below to get an
# email per request with one-click approve/reject confirmation links — that
# email is the ONLY way to review requests, there is no CLI or admin UI.
# Everyone else joins an EXISTING org via an admin invite
# (POST /admin/members) instead.

# =========================================================================
# HTTP API (app/api/) + frontend  — Phase 13/14
# =========================================================================
# Exact frontend origin(s) allowed to call the API with credentials.
# Needed only when the browser talks to this API *directly* (the local-direct
# escape hatch). The production portal uses same-origin `/api` rewrites, so
# CORS is not what carries the session cookie.
API_CORS_ORIGINS=http://localhost:3000
# API_HOST=0.0.0.0
# API_PORT=8000
#
# Base URL of the deployed frontend — used to build the magic-link login URL
# and the post-OAuth-connect redirect destination. Not the API host.
FRONTEND_URL=http://localhost:3000

# =========================================================================
# Outbound email for magic links  — Phase 13
# =========================================================================
# "console" (default): prints the sign-in link instead of sending it — no
# external dependency, works out of the box for local/self-hosted dev.
EMAIL_SENDER=console
# Set to "smtp" for real delivery on a host that allows outbound 587
# (local, a VPS, paid Render). Render's FREE web service blocks SMTP
# ports 25/465/587 — Gmail SMTP fails there with Errno 101 unreachable.
# EMAIL_SENDER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_SMTP_FROM=noreply@example.com
#
# Render free (and any host that blocks SMTP): HTTPS via Resend (port 443).
# Free tier: https://resend.com — until a domain is verified you can only
# send TO the email you signed up with, using From: beth.t@example.com
# EMAIL_SENDER=resend
# EMAIL_RESEND_API_KEY=re_...
# EMAIL_SMTP_FROM=Handbook <beth.t@example.com>
#
# Resend's sandbox-sender restriction (above) means it can only ever reach
# YOUR OWN inbox — a magic link addressed to an actual admin/employee gets a
# 403. SendGrid's free tier has no such restriction: verify one address with
# "Single Sender Verification" (Settings -> Sender Authentication -> Verify a
# Single Sender — just click a confirmation link, no DNS/domain needed), and
# it can deliver to ANY recipient. This is the recommended free path until a
# real domain is verified with a provider.
# EMAIL_SENDER=sendgrid
# EMAIL_SENDGRID_API_KEY=SG...
# EMAIL_SMTP_FROM=Handbook <your-verified-single-sender@example.com>
#
# Set this to get a notification email (with one-click approve/reject links)
# every time someone submits POST /auth/signup — required to review requests
# at all, since there is no CLI or admin UI for this queue.
# OWNER_NOTIFICATION_EMAIL=owner@yourcompany.com
#
# Reminder: the Notion OAuth app credentials for the admin "Connect Notion"
# flow are the NOTION_CLIENT_ID / NOTION_CLIENT_SECRET / NOTION_REDIRECT_URI
# vars already defined above in the Notion source section — they are consumed
# by NotionOAuthProvider. Google Drive uses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI (GoogleOAuthProvider).

# Rate limit for the unauthenticated magic-link endpoint, per IP per window.
# Separate from the chat limit on purpose: this endpoint is anonymous and keyed
# by IP, so a whole office behind one NAT shares a single bucket. It exists to
# bound bulk account enumeration — the endpoint reports whether an account
# exists, which is deliberate (see app/api/auth.py) but harvestable without it.
# RATE_LIMIT_AUTH_REQUESTS=60
